# Copy to backend/.env (git-ignored) or set in your host's secret manager. NEVER commit real values.
# The pipeline reads plain environment variables; load this file with your process manager
# (e.g. `set -a; . ./.env; set +a`) — the app itself does not auto-load it.

# Odds source: propline (free tier, default) or the-odds-api (paid).
ODDS_PROVIDER=propline
# Free key from https://prop-line.com (email only). In the Claude cloud environment the
# key is proxy-injected: set PROPLINE_API_KEY=proxy-injected there.
PROPLINE_API_KEY=
# PropLine free tier = 1,000 requests per UTC day; this local guard keeps headroom.
ODDS_DAILY_REQUEST_BUDGET=800
# Quotes from a bookmaker feed older than this are stored but flagged stale.
ODDS_STALE_AFTER_MIN=20

# The Odds API key (paid adapter). With no key for the active provider the pipeline makes
# no provider calls and records runs as "blocked_no_key".
ODDS_API_KEY=

# Local default is a SQLite file under backend/data/. Production: Postgres, e.g.
# NBA_EDGE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nba_edge
NBA_EDGE_DATABASE_URL=

# Books/markets (defaults shown). Each requested market costs credits per event call.
# ODDS_API_BOOKMAKERS=fanduel,fanatics          (add draftkings,pinnacle as references — free on PropLine)
# ODDS_API_MARKETS=player_points,player_points_alternate,player_rebounds,...

# Local spend guards — set ODDS_MONTHLY_CREDIT_BUDGET to (at most) your plan's monthly credits.
ODDS_MONTHLY_CREDIT_BUDGET=500
ODDS_MAX_CREDITS_PER_RUN=300

# Schedule (US Eastern): fixed daily slots + minutes-before-tip slots (last = closing).
# SNAPSHOT_FIXED_SLOTS_ET=10:00,15:00
# SNAPSHOT_PRETIP_OFFSETS_MIN=60,10
# Extra slots every N minutes (cheap on PropLine: ~1 request per whole-slate snapshot)
# SNAPSHOT_INTERVAL_MIN=15
# SNAPSHOT_INTERVAL_START_ET=10:00
# SNAPSHOT_INTERVAL_END_ET=23:00
